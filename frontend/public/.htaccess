Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS (Fixes HTTP to HTTPS redirect)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve llms.txt as plain text for AI crawlers (ChatGPT, Gemini, Claude)
<Files "llms.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

# Prevent stale browser caching for HTML and dynamic assets
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# Handle directory index for Next.js trailing slash output
DirectoryIndex index.html

# Error 404 redirect directly to home page
ErrorDocument 404 /

# Any non-existent file or directory redirects (302) directly to home page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ / [R=302,L]
