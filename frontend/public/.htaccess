Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS (Fixes HTTP to HTTPS redirect)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fast GZIP / Deflate compression for AI bots, mobile and desktop
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

# Serve llms.txt as plain text for AI crawlers (ChatGPT, Gemini, Claude)
<Files "llms.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

# Ensure HTML is always revalidated after deployments (no stale browser/CDN HTML cache)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>

# Handle directory index for Next.js trailing slash output
DirectoryIndex index.html
